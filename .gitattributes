# Normalise line endings for text files in the repository and working tree.
* text=auto eol=lf

# Source
*.kt      text eol=lf
*.java    text eol=lf
*.kts     text eol=lf
*.xml     text eol=lf
*.pro     text eol=lf
*.properties text eol=lf
*.json    text eol=lf

# Documentation
*.md      text eol=lf
LICENSE   text eol=lf

# Gradle wrapper must stay CRLF-safe and is always binary-safe
gradlew   text eol=lf
gradlew.bat text eol=crlf
gradle/wrapper/gradle-wrapper.jar binary

# Build configuration kept as-is (Android Studio defaults)
*.iml     text eol=lf
.idea/**  text eol=lf

# Assets — never diffed or line-ending converted
*.png     binary
*.jpg     binary
*.jpeg    binary
*.gif     binary
*.webp    binary
*.ico     binary
*.jar     binary
*.apk     binary

# Lockfiles / generated metadata
*.lock    text eol=lf
