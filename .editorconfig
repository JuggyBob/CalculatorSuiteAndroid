root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{kt,kts}]
indent_size = 4
max_line_length = 120

[*.{xml,gradle,properties}]
indent_size = 4

[*.bat]
end_of_line = crlf

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{yml,yaml,json}]
indent_size = 2

[*.{png,jpg,jpeg,gif,webp,ico,jar,apk}]
insert_final_newline = unset
trim_trailing_whitespace = unset
