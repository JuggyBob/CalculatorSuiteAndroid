<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- The camera writes the photograph here. -->
    <cache-path
        name="ai"
        path="ai/" />
    <!-- The updater writes the downloaded release here, so that the installer
         of Android can read it without any path of the phone being exposed. -->
    <cache-path
        name="updates"
        path="updates/" />
</paths>
